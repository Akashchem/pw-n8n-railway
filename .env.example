# ── Core ──────────────────────────────────────────────────────────────────────
# Set WEBHOOK_URL to your Railway public URL (e.g. https://pw-n8n.up.railway.app/)
WEBHOOK_URL=https://YOUR-APP-NAME.up.railway.app/
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_CHAR_HEX

# Basic auth to protect the UI (disable if you use n8n's built-in user management)
N8N_BASIC_AUTH_ACTIVE=false

# Enable n8n user management (recommended instead of basic auth)
N8N_USER_MANAGEMENT_DISABLED=false

# ── Persistence ────────────────────────────────────────────────────────────────
# Railway Volume must be mounted at /home/node/.n8n
N8N_USER_FOLDER=/home/node/.n8n

# SQLite (default) — stored on the volume, no extra DB service needed
DB_TYPE=sqlite
DB_SQLITE_VACUUM_ON_STARTUP=true

# ── Execution ─────────────────────────────────────────────────────────────────
# Keep execution logs for 30 days
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=720

# Allow n8n to call back to itself (needed for webhook + scheduler in same instance)
N8N_ALLOW_EXEC_COMMAND=false

# Timezone — match your IST campaigns
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# ── Optional: disable telemetry ───────────────────────────────────────────────
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
